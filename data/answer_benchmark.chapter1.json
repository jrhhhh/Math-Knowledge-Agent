[
  {"id":"ch1-direct-001","type":"proof_method","question":"证明若 n 为偶数，则 n^2 为偶数。","reference_answer":"设 n=2k，则 n^2=4k^2=2(2k^2)，所以 n^2 为偶数。","required_conditions":["n=2k"],"key_steps":["直接代入偶数定义","整理为 2 的倍数"],"common_errors":["把 n^2=2k^2 当作结论"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-direct-002","type":"proof_method","question":"证明两个偶数之和仍为偶数。","reference_answer":"设 a=2m,b=2n，则 a+b=2(m+n)，故为偶数。","required_conditions":["a=2m","b=2n"],"key_steps":["分别使用偶数定义","提取公因子 2"],"common_errors":["只说明直觉上偶数相加"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-contrapositive-001","type":"proof_method","question":"证明若 n^2 为奇数，则 n 为奇数。","reference_answer":"证明逆否命题：若 n 为偶数，则 n^2 为偶数。","required_conditions":["逆否命题等价"],"key_steps":["写出逆否命题","证明偶数平方为偶数"],"common_errors":["把逆命题当作逆否命题"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-contrapositive-002","type":"proof_method","question":"命题‘若 p 则 q’的逆否命题是什么？","reference_answer":"若非 q，则非 p。","required_conditions":["否定 p 和 q"],"key_steps":["交换前件与后件","同时取否定"],"common_errors":["写成若 q 则 p"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-contradiction-001","type":"proof_method","question":"反证法的第一步通常是什么？","reference_answer":"假设待证结论不成立，或假设其否定成立，然后推出矛盾。","required_conditions":["假设结论否定"],"key_steps":["建立反设","推出矛盾"],"common_errors":["直接重复原命题"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-contradiction-002","type":"proof_method","question":"为什么推出矛盾后可以得到原结论？","reference_answer":"因为反设导致矛盾，反设不可能成立，所以原结论成立。","required_conditions":["排中律或经典逻辑"],"key_steps":["反设不成立","原命题成立"],"common_errors":["把任意矛盾当成原结论本身"],"labels":{"conclusion":"correct","conditions":"partially_correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-induction-001","type":"proof_method","question":"数学归纳法包含哪两个基本步骤？","reference_answer":"证明初始情形成立，并证明从 n=k 成立可推出 n=k+1 成立。","required_conditions":["归纳起点","归纳假设"],"key_steps":["基础步骤","归纳步骤"],"common_errors":["只证明归纳步骤"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-induction-002","type":"proof_method","question":"只证明了 P(k) 蕴含 P(k+1)，能否推出对所有 n 成立？","reference_answer":"不能，还必须证明归纳起点 P(n0) 成立。","required_conditions":["归纳起点"],"key_steps":["识别缺失基础步骤"],"common_errors":["认为递推蕴含自动覆盖起点"],"labels":{"conclusion":"correct","conditions":"incorrect","reasoning":"partially_correct","citations":"unverified"}},
  {"id":"ch1-counterexample-001","type":"counterexample","question":"如何否定‘所有实数 x 都满足 x^2>x’？","reference_answer":"给出反例 x=0，此时 0^2>0 不成立。","required_conditions":["全称命题反例"],"key_steps":["选择 x=0","验证不等式失败"],"common_errors":["只给出一个满足命题的数"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-condition-001","type":"missing_condition","question":"证明连续函数在紧集上有界时，关键条件是什么？","reference_answer":"函数在紧集上连续，且定义域中的集合是紧集。","required_conditions":["连续性","紧集"],"key_steps":["应用紧集上的连续函数性质"],"common_errors":["只写函数连续而不说明集合紧"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"unverified"}},
  {"id":"ch1-invalid-001","type":"proof_error","question":"证明若 ab=0 则 a=0：因为 ab=0，所以 a=0。错误在哪里？","reference_answer":"缺少 b 不为 0 的条件；例如 a=1,b=0 时 ab=0 但 a 不为 0。","required_conditions":["b≠0 才能约去 b"],"key_steps":["发现约去零因子","给出反例"],"common_errors":["接受未经条件许可的约分"],"labels":{"conclusion":"incorrect","conditions":"incorrect","reasoning":"incorrect","citations":"unverified"}},
  {"id":"ch1-citation-001","type":"citation","question":"回答教材中的证明方法时，什么时候必须标出来源？","reference_answer":"当回答声称来自特定教材、定理或页码时，应提供对应的已审核教材片段；模型推断应明确标注。","required_conditions":["来源可核对"],"key_steps":["区分教材依据和模型推断"],"common_errors":["把模型生成当作教材原文"],"labels":{"conclusion":"correct","conditions":"correct","reasoning":"correct","citations":"correct"}}
